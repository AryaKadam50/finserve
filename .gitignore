# ============================================================
# FinServe .gitignore
# ============================================================

# ---------- Java / Maven ----------
finserve-backend/target/
*.jar
*.war
*.class
*.log

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# ---------- Node / React ----------
finserve-frontend/node_modules/
finserve-frontend/dist/
finserve-frontend/.env
finserve-frontend/.env.local
finserve-frontend/.env.production

# ---------- Environment & Secrets ----------
.env
*.env
application-prod.properties
application-prod.yml
*.pem
*.key
deploy/.instance-info

# ---------- OS ----------
.DS_Store
Thumbs.db
*.tmp

# ---------- Uploads (document storage) ----------
# These are runtime files generated by the app — never commit
finserve-backend/uploads/
finserve-backend/test-uploads/
uploads/

# ---------- Docker ----------
# Prevent accidental commit of docker volume data
docker-data/

# ---------- Deploy artifacts ----------
deploy/.instance-info
deploy/*.log
