# ============================================================
# FinServe Backend - Local Environment Variables
# ============================================================

PORT=8080
NODE_ENV=development

# MySQL Database connection string for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://finserve_user:finserve123@localhost:3306/finserve_db"

# JWT Secret for signing authentication tokens
JWT_SECRET="finserve_super_secret_jwt_key_local_dev_2026"
JWT_EXPIRES_IN="7d"

# Upload directory (relative to backend root or absolute)
UPLOAD_PATH="./uploads"

# Policy Thresholds & Rules
POLICY_MIN_CREDIT_SCORE=650
POLICY_MAX_DTI_RATIO=0.45
POLICY_MIN_INCOME=10000
POLICY_MAX_LOAN_TO_INCOME_MULTIPLIER=60
VERIFICATION_INCOME_TOLERANCE_PERCENT=5

# AI / OpenAI Configuration
# Leave blank to use the deterministic, locally simulated Mock Underwriting Agent
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AI_CONFIDENCE_THRESHOLD=0.70

# Default Local Admin Bootstrap Credentials
ADMIN_EMAIL="admin@finserve.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="FinServe Admin"
ADMIN_PHONE="9999999999"
